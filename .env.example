# Copia este archivo como .env.local y completa los valores reales.
# .env.local NO se sube al repo (ver .gitignore).

# --- Backend externo (hack-cis-uni-backend) ---
# URL usada en el servidor (lib/api-client.ts)
URL_BACKEND_HACK_CIS=https://hack-cis-uni-backend.onrender.com/api/v1/
# URL usada en el cliente/navegador (lib/api.ts, components/hacker-counter.tsx, app/register, app/sponsors)
NEXT_PUBLIC_URL_BACKEND_HACK_CIS=https://hack-cis-uni-backend.onrender.com/api/v1/

# --- Google Generative AI (Gemini) ---
# Server-side, usada por /api/hacker/generate-story (chat "Cispy" en /Boot)
GOOGLE_GENERATIVE_AI_API_KEY=

# Cliente, usada por lib/neobanana-service.ts (generador de flyer/banner con IA)
# OJO: al ser NEXT_PUBLIC_ queda visible en el navegador. Usar una key con
# restricciones/cuota limitada, nunca la misma que una key administrativa.
NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_API_KEY=

# --- Google Apps Script (proxy /api/backend/[...path]) ---
# Actualmente sin uso desde el frontend. Dejar vacío si no aplica.
GOOGLE_SCRIPT_URL=
