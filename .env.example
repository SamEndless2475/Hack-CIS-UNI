# Copia este archivo como .env.local y completa los valores reales.
# .env.local NO se sube al repo (ver .gitignore).

# --- Supabase (base de datos, auth y storage) ---
# Dashboard → Project Settings → API
#
# La clave anon es PUBLICA por diseño: viaja en el bundle del navegador y no es
# un secreto. Lo que protege los datos es RLS (ver supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=https://uevcvgkvrttbnqiorrlt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Token personal para correr migraciones con la CLI (npx supabase login lo genera).
# Solo hace falta en la máquina de quien aplica migraciones, nunca en el deploy.
# SUPABASE_ACCESS_TOKEN=

# OJO: la clave service_role NO va en este archivo ni en ningún NEXT_PUBLIC_.
# Salta todas las políticas de RLS. Si algún día hace falta, va como secreto
# del servidor (Vercel → Environment Variables, sin el prefijo NEXT_PUBLIC_).

# --- Google Generative AI (Gemini) ---
# Server-side, usada por /api/hacker/generate-story (chat "Cispy" en /Boot)
GOOGLE_GENERATIVE_AI_API_KEY=

# Cliente, usada por lib/neobanana-service.ts (generador de flyer con IA)
# OJO: al ser NEXT_PUBLIC_ queda visible en el navegador. Usar una key con
# restricciones/cuota limitada, nunca la misma que una key administrativa.
# Pendiente: mover esta generación al servidor para no exponerla.
NEXT_PUBLIC_GOOGLE_GENERATIVE_AI_API_KEY=

# --- Backend externo (RETIRADO) ---
# El Django de Render respondía 503 el 2026-10-17. Ya no se usa en ninguna parte:
# el registro, el contador y el formulario de sponsors hablan directo con Supabase.
# Si no lo van a revivir, se puede borrar del deploy:
#   NEXT_PUBLIC_URL_BACKEND_HACK_CIS
#   URL_BACKEND_HACK_CIS
#   GOOGLE_SCRIPT_URL  (el proxy /api/backend que la usaba ya no existe)
